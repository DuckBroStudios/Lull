rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isSelf(uid) { return request.auth != null && request.auth.uid == uid; }

    match /users/{uid} {
      allow read: if signedIn();
      allow write: if isSelf(uid);

      match /requests/{fromUid} {
        allow read, delete: if isSelf(uid);
        allow create: if signedIn() && request.auth.uid == fromUid;
      }

      match /friends/{friendUid} {
        allow read: if isSelf(uid);
        allow write: if isSelf(uid) || isSelf(friendUid);
      }
    }

    match /usernames/{name} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow update, delete: if signedIn() && resource.data.uid == request.auth.uid;
    }

    // Reminders shared between friends — only members can see or change them.
    match /sharedReminders/{id} {
      allow read:          if signedIn() && request.auth.uid in resource.data.members;
      allow create:        if signedIn() && request.auth.uid in request.resource.data.members;
      allow update, delete: if signedIn() && request.auth.uid in resource.data.members;
    }

    // Shared notepad spaces + their notes — only members can see or edit.
    match /spaces/{id} {
      allow read:          if signedIn() && request.auth.uid in resource.data.members;
      allow create:        if signedIn() && request.auth.uid in request.resource.data.members;
      allow update, delete: if signedIn() && request.auth.uid in resource.data.members;

      match /notes/{noteId} {
        allow read, write: if signedIn() && request.auth.uid in get(/databases/$(database)/documents/spaces/$(id)).data.members;
      }
    }
  }
}